---
export const prerender = true;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var s = window.screen;
        if (!s || !s.width || !s.height) return;
        var ratio = s.width / s.height;
        var cuadrado = ratio >= 1.05 && ratio <= 1.45;
        var chico = s.width <= 1700 && s.height <= 1300 && s.height >= 560;
        var bajo = s.height <= 900;
        if ((!cuadrado || !chico) && !bajo) return;
        document.documentElement.classList.add("monitor-viejo");
      })();
    </script>
    <meta name="robots" content="noindex,nofollow" />
    <title>Gasonor SRL — Trazabilidad de tubos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/interno/css/app.css?v=115" />
    <link rel="icon" href="/interno/img/logo.png?v=30" />
  </head>
  <body>
    <button type="button" class="menu-backdrop" id="menu-backdrop" aria-label="Cerrar men&#250;"></button>
    <aside class="sidebar">
      <div class="brand">
        <img class="brand-logo" src="/interno/img/logo.png?v=30" alt="Gasonor SRL" />
        <div>
          <strong id="brand-name">Gasonor SRL</strong>
          <small>Trazabilidad de tubos</small>
        </div>
      </div>
      <nav>
        <a href="#/inicio" data-nav="inicio">Inicio</a>

        <div class="nav-group" data-nav-group>
          <span class="nav-label">Cat&#225;logo</span>
          <a href="#/proveedores" data-nav="proveedores" data-roles="admin">Proveedores</a>
          <a href="#/compras" data-nav="compras" data-roles="admin" data-solo-pc="1">Compras y deudas</a>
          <a href="#/clientes" data-nav="clientes" data-roles="admin">Clientes</a>
          <a href="#/catalogo" data-nav="catalogo" data-roles="admin">Tubos y art&#237;culos</a>
        </div>

        <div class="nav-group" data-nav-group>
          <span class="nav-label">Env&#237;os y recepciones</span>
          <a href="#/envios/planta" data-nav="envios" data-roles="admin,despacho" data-solo-celular="1">Planta</a>
          <a href="#/envios/cliente" data-nav="envios" data-roles="admin,reparto" data-solo-celular="1">Cliente</a>
          <a href="#/ordenes-servicio" data-nav="ordenes-servicio" data-roles="admin,cobrador,despacho,reparto">&#211;rdenes de servicio</a>
          <a href="#/planta/completar" data-nav="planta" data-roles="admin" data-solo-pc="1">Completar despachos y recepciones</a>
          <a href="#/operaciones" data-nav="operaciones" data-roles="admin">Ciclo de despacho</a>
        </div>

        <div class="nav-group" data-nav-group>
          <span class="nav-label">Caja</span>
          <a href="#/cobrar" data-nav="cobrar" data-roles="cobrador,admin">Cobrar</a>
          <a href="#/facturar" data-nav="facturar" data-roles="admin,cobrador">Facturar</a>
          <a href="#/ventas" data-nav="ventas" data-roles="admin,cobrador">Ventas</a>
          <a href="#/deudas" data-nav="deudas" data-roles="admin,cobrador">Deudas</a>
          <a href="#/cheques" data-nav="cheques" data-roles="admin,cobrador">Cheques</a>
          <a href="#/caja/config" data-nav="caja-config" data-roles="admin">Configuraci&#243;n</a>
        </div>

        <div class="nav-group" data-nav-group>
          <span class="nav-label">Log&#237;stica y prospectos</span>
          <a href="#/reparto" data-nav="reparto" data-roles="admin,reparto">Reparto</a>
          <a href="#/prospeccion" data-nav="prospeccion" data-roles="admin">Prospecci&#243;n</a>
          <a href="#/calendario" data-nav="calendario" data-roles="admin">Calendario</a>
        </div>

        <div class="nav-group" data-nav-group>
          <span class="nav-label">Administraci&#243;n</span>
          <a href="#/empleados" data-nav="empleados" data-roles="admin">Empleados</a>
          <a href="#/usuarios" data-nav="usuarios" data-roles="admin">Usuarios</a>
          <a href="#/informe" data-nav="informe" data-roles="admin">Informe de expedici&#243;n</a>
          <a href="#/movimientos" data-nav="movimientos" data-roles="admin">Historial</a>
          <a href="#/config" data-nav="config" data-roles="admin">Empresa</a>
        </div>
      </nav>
      <p class="sidebar-foot">Ciclo: vac&#237;o &rarr; cargado &rarr; cliente &rarr; vac&#237;o</p>
    </aside>

    <main class="main">
      <header class="topbar">
        <button type="button" class="btn-menu" id="btn-menu" aria-label="Men&#250;">&#9776;</button>
        <form id="busqueda-global" class="search" autocomplete="off">
          <input id="q-global" type="search" placeholder="Buscar n&#250;mero de tubo, lote o cliente&#8230;" autocomplete="off" />
          <button type="submit">Buscar</button>
        </form>
        <div class="topbar-meta">
          <span id="quien"></span>
          <span id="reloj"></span>
          <button type="button" class="btn ghost" id="btn-salir">Salir</button>
        </div>
      </header>
      <div id="toast" hidden></div>
      <section id="app" class="page"></section>
    </main>

    <div id="login-screen" class="login-screen" hidden>
      <form id="form-login" class="card login-card" autocomplete="off" method="post" action="javascript:void(0)">
        <img src="/interno/img/logo.png?v=30" alt="Gasonor SRL" />
        <h1>Ingresar</h1>
        <div class="field"><label>Usuario</label><input name="usuario" required autocomplete="off" autocapitalize="off" spellcheck="false" /></div>
        <div class="field"><label>Clave</label><input name="clave" type="password" required autocomplete="new-password" data-lpignore="true" data-1p-ignore="true" /></div>
        <button class="btn copper" type="submit">Entrar</button>
      </form>
    </div>
    <script is:inline src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script is:inline src="/interno/js/scan.js?v=36"></script>
    <script is:inline src="/interno/js/app.js?v=115"></script>
  </body>
</html>
